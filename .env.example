# ─────────────────────────────────────────────────────────────
# Supabase — قاعدة بيانات المنصّة
# انسخ هذا الملف إلى .env.local واملأ القيم من لوحة Supabase:
#   Project Settings → API
# ─────────────────────────────────────────────────────────────

# رابط المشروع (Project URL) — مثال: https://xxxxxxxx.supabase.co
SUPABASE_URL=

# مفتاح service_role السرّي — للخادم فقط، لا يُكشف أبداً في المتصفّح.
# (Project Settings → API → service_role, secret)
SUPABASE_SERVICE_ROLE_KEY=

# سرٌّ عشوائي لتوقيع جلسة الدخول (أيّ نصّ طويل عشوائي، 32 حرفاً فأكثر)
SESSION_SECRET=
